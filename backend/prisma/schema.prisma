generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TECHNICIAN
  JOB_CONTROLLER
  SUPERVISOR
  ADMINISTRATOR
}

enum UserStatus {
  ONLINE
  WORKING
  AVAILABLE
  OFFLINE
}

enum WoType {
  REPAIR
  INSTALLATION
  TRANSFER
}

enum WoStatus {
  DRAFT
  ASSIGNED
  WORKING
  ON_HOLD
  COMPLETED
  FB_ISSUE
  CUST_ISSUE
  CANCELLED
}

model Team {
  id          String       @id @default(uuid())
  name        String
  users       User[]
  assignments Assignment[]
  createdAt   DateTime     @default(now())
}

model User {
  id             String     @id @default(uuid())
  role           UserRole
  teamId         String?
  team           Team?      @relation(fields: [teamId], references: [id])
  name           String
  phone          String?
  email          String?    @unique
  passwordHash   String?
  isActive       Boolean    @default(true)
  status         UserStatus @default(OFFLINE)
  lastLat        Float?
  lastLng        Float?
  lastLocationAt DateTime?
  createdAt      DateTime   @default(now())
}

model Nap {
  id         String   @id @default(uuid())
  napCode    String   @unique
  address    String?
  lat        Float?
  lng        Float?
  portCount  Int      @default(16)
  verified   Boolean  @default(false)
  verifiedBy String?
  verifiedAt DateTime?
  createdAt  DateTime @default(now())
}

model Subscriber {
  id            String   @id @default(uuid())
  accountNumber String?  @unique
  name          String
  address       String
  contactNumber String?
  plan          String?
  lat           Float?
  lng           Float?
  napId         String?
  napPort       Int?
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model WorkOrder {
  id                 String                 @id @default(uuid())
  woNumber           String                 @unique
  type               WoType
  status             WoStatus               @default(DRAFT)
  subscriberId       String?
  oldNapId           String?
  oldPort            Int?
  newNapId           String?
  newPort            Int?
  priority           Int                    @default(3)
  remarks            String?
  createdBy          String?
  createdAt          DateTime               @default(now())
  assignments        Assignment[]
  executions         JobExecution[]
  customerSignatures CustomerSignature[]
  transfers          Transfer[]
  uploadTickets      EvidenceUploadTicket[]
  fieldExceptions    FieldException[]
}

model Assignment {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id])
  assignedBy  String?
  assignedAt  DateTime  @default(now())

  @@unique([workOrderId, teamId])
}

model JobExecution {
  id              String                 @id @default(uuid())
  workOrderId     String
  workOrder       WorkOrder              @relation(fields: [workOrderId], references: [id])
  technicianId    String
  startedAt       DateTime               @default(now())
  completedAt     DateTime?
  findings        String?
  rxPower         Float?
  downloadMbps    Int?
  uploadMbps      Int?
  pingMs          Int?
  napCodeReported String?
  portReported    Int?
  status          WoStatus?
  photos          Photo[]
  uploadTickets   EvidenceUploadTicket[]
  fieldExceptions FieldException[]
  createdAt       DateTime               @default(now())
}

model FieldException {
  id           String       @id @default(uuid())
  workOrderId  String
  workOrder    WorkOrder    @relation(fields: [workOrderId], references: [id])
  executionId  String
  execution    JobExecution @relation(fields: [executionId], references: [id])
  technicianId String
  reason       String
  notes        String?
  lat          Float?
  lng          Float?
  status       String       @default("PENDING")
  reportedAt   DateTime     @default(now())
  reviewedBy   String?
  reviewedAt   DateTime?
  resolution   String?
  resumeAt     DateTime?

  @@index([workOrderId, status, reportedAt])
  @@index([technicianId, reportedAt])
}

model Photo {
  id           String                @id @default(uuid())
  executionId  String
  execution    JobExecution          @relation(fields: [executionId], references: [id])
  type         String
  s3Key        String                @unique
  url          String?
  lat          Float?
  lng          Float?
  capturedAt   DateTime              @default(now())
  isRequired   Boolean               @default(true)
  uploadTicket EvidenceUploadTicket?
}

model EvidenceUploadTicket {
  id           String       @id @default(uuid())
  workOrderId  String
  workOrder    WorkOrder    @relation(fields: [workOrderId], references: [id])
  executionId  String
  execution    JobExecution @relation(fields: [executionId], references: [id])
  technicianId String
  evidenceType String
  storageKey   String       @unique
  contentType  String
  sizeBytes    Int
  provider     String
  status       String       @default("ISSUED")
  expiresAt    DateTime
  consumedAt   DateTime?
  photoId      String?      @unique
  photo        Photo?       @relation(fields: [photoId], references: [id])
  createdAt    DateTime     @default(now())

  @@index([workOrderId, executionId, technicianId, status])
}

model LocationLog {
  id        BigInt     @id @default(autoincrement())
  userId    String
  lat       Float
  lng       Float
  status    UserStatus
  isStale   Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
}

model Mismatch {
  id            String   @id @default(uuid())
  workOrderId   String?
  type          String
  dbValue       String?
  reportedValue String
  reportedBy    String?
  status        String   @default("PENDING")
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  workOrderId String?
  actorId     String?
  action      String
  details     Json?
  createdAt   DateTime @default(now())
}

model CustomerSignature {
  id              String    @id @default(uuid())
  workOrderId     String
  workOrder       WorkOrder @relation(fields: [workOrderId], references: [id])
  executionId     String?
  signatureData   String    @db.Text
  signedByName    String
  signedByContact String?
  signedAt        DateTime  @default(now())
  ipAddress       String?
  deviceInfo      Json?
  isVerified      Boolean   @default(false)
}

model OptimizedRoute {
  id                   String   @id @default(uuid())
  technicianId         String?
  teamId               String?
  date                 DateTime
  routeOrder           Json
  totalDistanceMeters  Int?
  totalDurationMinutes Int?
  optimizationScore    Float?
  createdAt            DateTime @default(now())
}

model RouteHistory {
  id           BigInt   @id @default(autoincrement())
  technicianId String
  lat          Float
  lng          Float
  speedKmh     Float?
  heading      Float?
  createdAt    DateTime @default(now())

  @@index([technicianId, createdAt])
}

model AnalyticsSnapshot {
  id           String   @id @default(uuid())
  snapshotDate DateTime
  metrics      Json
  createdAt    DateTime @default(now())
}

model WorkflowRule {
  id            String              @id @default(uuid())
  name          String
  triggerEvent  String
  conditionJson Json?
  actionType    String
  actionConfig  Json
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  executions    WorkflowExecution[]
}

model WorkflowExecution {
  id          String       @id @default(uuid())
  ruleId      String
  rule        WorkflowRule @relation(fields: [ruleId], references: [id])
  workOrderId String?
  status      String       @default("PENDING")
  result      Json?
  createdAt   DateTime     @default(now())
}

model NapHealth {
  id                String   @id @default(uuid())
  napId             String?
  napCode           String
  healthScore       Int?
  portUtilization   Float?
  recentIssuesCount Int      @default(0)
  avgRxPower        Float?
  lastChecked       DateTime @default(now())
  alerts            Json     @default("[]")
}

model NetworkAlert {
  id         String   @id @default(uuid())
  type       String
  napId      String?
  severity   String   @default("MEDIUM")
  message    String
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model IntegrationJob {
  id             String    @id @default(uuid())
  sourceSystem   String
  targetSystem   String?
  payload        Json
  status         String    @default("PENDING")
  idempotencyKey String?
  retries        Int       @default(0)
  maxRetries     Int       @default(5)
  nextAttemptAt  DateTime  @default(now())
  claimedAt      DateTime?
  claimToken     String?
  lastAttemptAt  DateTime?
  lastError      String?
  completedAt    DateTime?
  failedAt       DateTime?
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  @@unique([sourceSystem, idempotencyKey])
  @@index([status, nextAttemptAt, createdAt])
  @@index([claimToken])
}

model Transfer {
  id              String    @id @default(uuid())
  workOrderId     String
  workOrder       WorkOrder @relation(fields: [workOrderId], references: [id])
  oldNapId        String?
  oldPort         Int?
  oldLat          Float?
  oldLng          Float?
  removalEvidence String[]  @default([])
  newNapId        String?
  newPort         Int?
  newLat          Float?
  newLng          Float?
  installEvidence String[]  @default([])
  createdAt       DateTime  @default(now())
}


// Phase 5E.2 fleet-wide admission control. Disabled until explicitly approved.
// This model alone does not enforce admission fencing or worker safety.
model IntegrationFleetControl {
  id         String   @id @default("GLOBAL")
  enabled    Boolean  @default(false)
  generation BigInt   @default(0)
  stoppedAt  DateTime?
  stoppedBy  String?
  reasonCode String?
  updatedAt  DateTime @updatedAt
}

// Phase 5E.2AE: durable expected membership and generation-bound stop acknowledgments.
// These records are advisory safety evidence, never proof of provider quiescence.
// Phase 5E.2AF: deployment-controlled expected worker inventory.
// Enrollment is an internal, operator-controlled operation; no public route.
// Phase 5E.2AH: immutable two-actor worker roster governance evidence.
// Not a production identity-provider integration.
model IntegrationWorkerGovernanceEvent {
  id          String   @id @default(uuid())
  workerId    String
  operation   String
  action      String
  actorId     String
  sessionHash String
  createdAt   DateTime @default(now())
  @@unique([workerId, operation, actorId, action])
  @@index([workerId, operation, action])
}

model IntegrationExpectedWorker {
  workerId       String   @id
  credentialHash String
  approvedBy     String
  approvedAt     DateTime @default(now())
  retiredAt      DateTime?
}

model IntegrationWorkerMembership {
  workerId       String   @id
  instanceToken  String
  generation     BigInt
  registeredAt   DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  stopAckGeneration BigInt?
  stopAckAt      DateTime?
  activeAttempts Int      @default(0)
  @@index([generation, stopAckGeneration])
}

model IntegrationAdmission {
  id          String    @id @default(uuid())
  jobId       String
  claimToken  String
  generation  BigInt
  status      String    @default("ADMITTED")
  admittedAt  DateTime  @default(now())
  releasedAt  DateTime?

  @@index([jobId, claimToken])
  @@index([status, generation])
}


// Phase 5E.2P: append-only evidence-backed operator resolution record.
// No public write endpoint; migration trigger rejects updates and deletes.
model IntegrationReconciliationAudit {
  id               String   @id @default(uuid())
  admissionId      String   @unique
  jobId            String
  provider         String
  providerRequestId String
  outcome          String
  evidenceRef      String
  operatorId       String
  reviewerId       String
  reasonCode       String
  recordedAt       DateTime @default(now())

  @@index([jobId, recordedAt])
}


// Phase 5E.2Q: independently registered reconciliation evidence.
// There is deliberately no public create/approve endpoint.
model IntegrationProviderEvidence {
  id                String   @id @default(uuid())
  admissionId       String   @unique
  provider          String
  providerRequestId String
  evidenceRef       String
  confirmedOutcome  String
  operatorId        String
  reviewerId        String
  validated         Boolean  @default(false)
  recordedAt        DateTime @default(now())
}


// Phase 5E.2S: append-only session-bound approval intentions.
// A proposal and independent approval must be recorded separately.
model IntegrationApprovalEvent {
  id            String   @id @default(uuid())
  admissionId   String
  actorUserId   String
  action        String
  evidenceId    String
  sessionIdHash String
  recordedAt    DateTime @default(now())

  @@unique([admissionId, actorUserId, action])
  @@index([admissionId, action])
}


// Phase 5E.2U: durable replay ledger for synthetic signed receipts.
model IntegrationMockReceiptReplay {
  id          String   @id @default(uuid())
  requestId   String
  issuedAt    Int
  signature   String
  admissionId String
  recordedAt  DateTime @default(now())

  @@unique([requestId, issuedAt, signature])
  @@unique([requestId])
  @@index([admissionId])
}

// Phase 5E.2V: immutable synthetic signing-key metadata, no raw secret.
model IntegrationMockSigningKey {
  id          String   @id
  fingerprint String
  validFrom   DateTime
  validUntil  DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
}

// Phase 5E.2X: append-only independent identity attribution for signed evidence.
model IntegrationEvidenceAttribution {
  id            String   @id @default(uuid())
  evidenceId    String
  admissionId   String
  actorUserId   String
  action        String
  sessionHash   String
  recordedAt    DateTime @default(now())

  @@unique([evidenceId, actorUserId, action])
  @@index([evidenceId, action])
}
