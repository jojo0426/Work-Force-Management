# WFM backend local development configuration
# Copy this file to backend/.env and replace placeholder values locally.
# Never commit real credentials or production secrets.

NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://fiberblaze:CHANGE_ME@localhost:5432/fiberblaze_wfm?schema=public"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"

# Comma-separated trusted web origins allowed to call the API from browsers.
# Production startup requires this value to be configured explicitly.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Integration execution policy. Defaults are intentionally fail-closed.
# Phase 5C.1A does not register or activate any real external provider.
INTEGRATION_EXECUTION_ENABLED=false
INTEGRATION_ALLOWED_TARGETS=""
INTEGRATION_EXECUTION_TIMEOUT_MS=30000
INTEGRATION_RETRY_DELAY_MS=30000

# One-time initial administrator bootstrap.
# Set these locally only when running the seed for a new environment.
# After the administrator exists, remove/clear BOOTSTRAP_ADMIN_PASSWORD.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="WFM Administrator"

S3_REGION=""
S3_BUCKET=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
